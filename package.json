{
  "name": "epro8-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern, faster replica and improvement of the EPro8 Challenge electronics simulator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "verify": "esbuild scripts/verify.ts --bundle --format=esm --platform=node --alias:@=./src --outfile=scripts/.verify.mjs && node scripts/.verify.mjs",
    "smoke": "esbuild scripts/smoke-entry.ts --bundle --format=esm --platform=browser --alias:@=./src --loader:.css=empty --outfile=scripts/app-bundle.mjs && node scripts/dom-smoke.mjs"
  },
  "dependencies": {
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  }
}
